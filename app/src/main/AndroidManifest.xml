<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.util.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_skga_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_skga_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SKGA">
        <activity
            android:name=".presentation.adminPage.eventsPage.EventsAddAndEditActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.adminPage.eventsPage.EventsManageActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.CreateNewPasswordActivity"
            android:exported="true">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="reset-password"
                    android:scheme="skga" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.adminPage.teacherPage.TeacherInfoActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.adminPage.teacherPage.TeacherAddEditActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.adminPage.teacherPage.TeacherManageActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.adminPage.scheduleManage.AddAndEditLessonActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.adminPage.scheduleManage.ScheduleManageActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.adminPage.AdminPageActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.MainMenuActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.WelcomeScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.skga.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".presentation.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>