<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearestEventCV1"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginStart="20dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="20dp"
    app:cardCornerRadius="10dp"
    app:layout_constraintTop_toBottomOf="@id/nearestEvents">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardColorStripe5"
            android:layout_width="4dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/red"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/eventNameTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="15dp"
            android:maxWidth="300dp"
            android:text="Экзамен :Высшая математика"
            android:maxLines="2"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/eventDateIc"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/calendar_ic"
            android:tint="@color/black"
            app:layout_constraintBottom_toTopOf="@id/eventTimeIc"
            app:layout_constraintStart_toStartOf="@id/eventNameTV"
            app:layout_constraintTop_toBottomOf="@id/eventNameTV"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/eventDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="10.12.2026"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/eventDateIc"
            app:layout_constraintStart_toEndOf="@id/eventDateIc"
            app:layout_constraintTop_toTopOf="@id/eventDateIc" />

        <ImageView
            android:id="@+id/eventTimeIc"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/clock_ic"
            android:tint="@color/black"
            app:layout_constraintBottom_toTopOf="@id/eventRoomIc"
            app:layout_constraintStart_toStartOf="@id/eventNameTV"
            app:layout_constraintTop_toBottomOf="@id/eventDateIc"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/eventTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="9:00-10:40"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/eventTimeIc"
            app:layout_constraintStart_toEndOf="@id/eventTimeIc"
            app:layout_constraintTop_toTopOf="@id/eventTimeIc" />

        <ImageView
            android:id="@+id/eventRoomIc"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/location_ic"
            android:tint="@color/black"
            app:layout_constraintBottom_toTopOf="@id/eventAudienceIc"
            app:layout_constraintStart_toStartOf="@id/eventTimeIc"
            app:layout_constraintTop_toBottomOf="@id/eventTimeIc" />

        <TextView
            android:id="@+id/eventLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="Кабинет 251"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/eventRoomIc"
            app:layout_constraintStart_toEndOf="@id/eventRoomIc"
            app:layout_constraintTop_toTopOf="@id/eventRoomIc" />

        <ImageView
            android:id="@+id/eventAudienceIc"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/groups_ic"
            android:tint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/eventRoomIc"
            app:layout_constraintTop_toBottomOf="@id/eventRoomIc" />

        <TextView
            android:id="@+id/eventPeoples"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="Группа ПМИ-221"
            android:textStyle="bold"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/eventAudienceIc"
            app:layout_constraintStart_toEndOf="@id/eventAudienceIc"
            app:layout_constraintTop_toTopOf="@id/eventAudienceIc" />

        <TextView
            android:id="@+id/eventType"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_text_border"
            android:gravity="center"
            android:padding="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Экзамен"
            android:textColor="@color/black"
            android:textSize="9sp"
            app:layout_constraintStart_toStartOf="@id/eventNameTV"
            app:layout_constraintTop_toBottomOf="@id/eventNameTV" />

        <TextView
            android:id="@+id/eventDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/eventType"
            app:layout_constraintStart_toStartOf="@id/eventType"
            android:text="Описание"
            android:layout_marginTop="10dp"
            android:textSize="10sp"
            android:maxWidth="300dp"
            android:maxLines="3"
            android:gravity="left"
            />

        <ImageView
            android:id="@+id/isActualIc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/check_ic"
            app:tint="@android:color/holo_green_dark"
            app:layout_constraintStart_toEndOf="@id/eventNameTV"
            app:layout_constraintTop_toTopOf="@id/eventNameTV"
            app:layout_constraintBottom_toBottomOf="@id/eventNameTV"
            android:layout_marginStart="5dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
