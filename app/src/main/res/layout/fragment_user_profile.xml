<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userProfileFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profileImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="50dp"
        android:scaleType="centerCrop"
        android:src="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageStyle" />


    <TextView
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Булхай Каракетов"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileImage" />


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#1D1F23"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/userName"
        app:strokeWidth="0dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNotificationSetting"
                style="@style/SettingsButtonStyle.First"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/red_alpha"
                android:text="Уведомления"
                app:icon="@drawable/notification_icon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSetting"
                style="@style/SettingsButtonStyle.Middle"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/red_alpha"
                android:text="Настройки"
                app:icon="@drawable/setting_icon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSupport"
                style="@style/SettingsButtonStyle.Last"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/red_alpha"
                android:text="Поддержка"
                app:icon="@drawable/support_icon" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:id="@+id/buttonExitFromAccount"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginBottom="200dp"
        android:paddingStart="40dp"
        android:paddingEnd="50dp"
        android:text="Выйти из аккаунта"
        android:textColor="@color/red_alpha"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:icon="@drawable/exit_from_icon"
        app:iconTint="@color/red_alpha"
        app:iconPadding="10dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>