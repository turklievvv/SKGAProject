<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.SKGA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SKGA" parent="Base.Theme.SKGA" />

    <style name="CircleImageStyle">
        <item name="cornerSize">50%</item>
    </style>

    <style name="SettingsButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#FFFFFF</item>

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">0dp</item>

        <item name="iconPadding">16dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">#E0E0E0</item>

        <item name="iconGravity">start</item>
    </style>

    <style name="SettingsButtonStyle.First" parent="SettingsButtonStyle">
        <item name="shapeAppearanceOverlay">@style/TopRoundedCorner</item>
    </style>

    <style name="SettingsButtonStyle.Middle" parent="SettingsButtonStyle">
        <item name="shapeAppearanceOverlay">@style/SquareCorner</item>
        <item name="android:layout_marginBottom">-1dp</item>
        <item name="strokeColor">@color/red_alpha</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="SettingsButtonStyle.Last" parent="SettingsButtonStyle">
        <item name="shapeAppearanceOverlay">@style/BottomRoundedCorner</item>
    </style>

    <style name="TopRoundedCorner">
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="BottomRoundedCorner">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">12dp</item>
        <item name="cornerSizeBottomRight">12dp</item>
    </style>

    <style name="SquareCorner">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="DayButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:checkable">true</item>
    </style>
</resources>